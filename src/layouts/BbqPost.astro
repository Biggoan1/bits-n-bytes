---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags?: string[];
  author?: string;
  cook?: string;
  cookTime?: string;
  smoker?: string;
  rating?: number;
}

const {
  title, description, pubDate, updatedDate,
  category, tags = [], author = 'JD',
  cook, cookTime, smoker, rating,
} = Astro.props;

const stars = rating ? '★'.repeat(rating) + '☆'.repeat(5 - rating) : null;
const hasCookStats = Boolean(cook || cookTime || smoker || rating);
---

<BaseLayout title={title} description={description} article={true} pubDate={pubDate}>
  <article class="container-narrow">
    <header class="post-header">
      <div class="meta">
        <FormattedDate date={pubDate} />
        <span> · </span>
        <span class="pill bbq-pill">{category}</span>
        <span> · </span>
        <span class="faint">{author}</span>
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {updatedDate && (
        <p class="faint">Last updated <FormattedDate date={updatedDate} /></p>
      )}

      {hasCookStats && (
        <dl class="cook-stats">
          {cook && (<><dt>Cook</dt><dd>{cook}</dd></>)}
          {cookTime && (<><dt>Time</dt><dd>{cookTime}</dd></>)}
          {smoker && (<><dt>Smoker</dt><dd>{smoker}</dd></>)}
          {rating && stars && (<><dt>Rating</dt><dd>{stars}</dd></>)}
        </dl>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      <div>
        {tags.map((tag) => (
          <span class="pill">#{tag}</span>
        ))}
      </div>
      <p class="faint"><a href="/bbq/">← All BBQ posts</a></p>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header { margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
  .post-header .meta { color: var(--fg-faint); font-size: 0.9rem; margin-bottom: 0.75rem; }
  .lede { font-size: 1.1rem; color: var(--fg-muted); margin-top: 0.5rem; }

  .bbq-pill {
    background: rgba(220, 38, 38, 0.08);
    color: #b91c1c;
    border-color: rgba(220, 38, 38, 0.3);
  }
  :root[data-theme="dark"] .bbq-pill {
    background: rgba(248, 113, 113, 0.12);
    color: #fca5a5;
    border-color: rgba(248, 113, 113, 0.35);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .bbq-pill {
      background: rgba(248, 113, 113, 0.12);
      color: #fca5a5;
      border-color: rgba(248, 113, 113, 0.35);
    }
  }

  .cook-stats {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1.25rem;
    margin: 1.25rem 0 0;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    font-size: 0.95rem;
  }
  .cook-stats dt {
    color: var(--fg-faint);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    align-self: center;
  }
  .cook-stats dd { margin: 0; color: var(--fg); }

  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 1rem 0; }
  .prose :global(h2) { margin-top: 2.5rem; }
  .prose :global(img) { border-radius: var(--radius); border: 1px solid var(--border); }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
</style>
